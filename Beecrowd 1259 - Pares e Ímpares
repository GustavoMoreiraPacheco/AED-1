#include <stdio.h>
#include <stdlib.h>

int comparar_pares(const void *a, const void *b) {
    return (*(int *)a - *(int *)b);
}

int comparar_impares(const void *a, const void *b) {
    return (*(int *)b - *(int *)a);
}

int main() {
    int N;
    scanf("%d", &N);

    int valores[N];
    int pares[N], impares[N];
    int num_pares = 0, num_impares = 0;

    for (int i = 0; i < N; i++) {
        scanf("%d", &valores[i]);
        if (valores[i] % 2 == 0) {
            pares[num_pares++] = valores[i];
        } else {
            impares[num_impares++] = valores[i];
        }
    }

    qsort(pares, num_pares, sizeof(int), comparar_pares);
    qsort(impares, num_impares, sizeof(int), comparar_impares);

    for (int i = 0; i < num_pares; i++) {
        printf("%d\n", pares[i]);
    }
    for (int i = 0; i < num_impares; i++) {
        printf("%d\n", impares[i]);
    }

    return 0;
}

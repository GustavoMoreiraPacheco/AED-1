#include <stdio.h>
#include <string.h>

int contar_diamantes(char *linha) {
    int diamantes = 0;
    int pilha = 0;

    for (int i = 0; linha[i] != '\0'; i++) {
        if (linha[i] == '<') {
            pilha++;
        } else if (linha[i] == '>' && pilha > 0) {
            pilha--;
            diamantes++;
        }
    }

    return diamantes;
}

int main() {
    int N;
    scanf("%d", &N);
    char linha[1001];

    for (int i = 0; i < N; i++) {
        scanf("%s", linha);
        printf("%d\n", contar_diamantes(linha));
    }

    return 0;
}

#include <stdio.h>
#include <string.h>

int diferencas_assinatura(char *original, char *assinatura) {
    int diferencas = 0;
    for (int i = 0; i < strlen(original); i++) {
        if (original[i] != assinatura[i]) {
            diferencas++;
            if (diferencas > 1) {
                return diferencas;
            }
        }
    }
    return diferencas;
}

int main() {
    int N;

    while (scanf("%d", &N) && N != 0) {
        char nomes[N][21];
        char originais[N][21];

        for (int i = 0; i < N; i++) {
            scanf("%s %s", nomes[i], originais[i]);
        }

        int M;
        scanf("%d", &M);
        int falsas = 0;

        for (int i = 0; i < M; i++) {
            char nome[21], assinatura[21];
            scanf("%s %s", nome, assinatura);

            for (int j = 0; j < N; j++) {
                if (strcmp(nomes[j], nome) == 0) {
                    if (diferencas_assinatura(originais[j], assinatura) > 1) {
                        falsas++;
                    }
                    break;
                }
            }
        }

        printf("%d\n", falsas);
    }

    return 0;
}

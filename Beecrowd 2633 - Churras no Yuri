#include <stdio.h>
#include <stdlib.h>
#include <string.h>

typedef struct {
    char nome[21];
    int validade;
} Carne;

int comparar(const void *a, const void *b) {
    Carne *carneA = (Carne *)a;
    Carne *carneB = (Carne *)b;
    return carneA->validade - carneB->validade;
}

int main() {
    int N;
    
    while (scanf("%d", &N) != EOF) {
        if (N == 0) {
            printf("\n");
            continue;
        }

        Carne carnes[N];

        for (int i = 0; i < N; i++) {
            scanf("%s %d", carnes[i].nome, &carnes[i].validade);
        }

        qsort(carnes, N, sizeof(Carne), comparar);

        for (int i = 0; i < N; i++) {
            if (i > 0) printf(" ");
            printf("%s", carnes[i].nome);
        }
        printf("\n");
    }

    return 0;
}

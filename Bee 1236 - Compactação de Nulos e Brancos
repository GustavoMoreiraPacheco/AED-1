#include <stdio.h>
#include <string.h>

void compactar_linha(char *linha) {
    int tamanho = strlen(linha);
    for (int i = 0; i < tamanho; i++) {
        char caractere = linha[i];
        int contador = 1;

        while (i + 1 < tamanho && linha[i + 1] == caractere) {
            contador++;
            i++;
        }

        if (caractere == ' ' && contador > 2) {
            while (contador > 255) {
                printf("$\xFF");
                contador -= 255;
            }
            printf("$%c", contador);
        } else if (caractere == '0' && contador > 2) {
            while (contador > 255) {
                printf("#\xFF");
                contador -= 255;
            }
            printf("#%c", contador);
        } else {
            for (int j = 0; j < contador; j++) {
                putchar(caractere);
            }
        }
    }
    printf("\n");
}

int main() {
    int N;
    scanf("%d", &N);
    getchar();

    for (int i = 0; i < N; i++) {
        char linha[2001];
        fgets(linha, sizeof(linha), stdin);
        linha[strcspn(linha, "\n")] = 0;
        compactar_linha(linha);
    }

    return 0;
}

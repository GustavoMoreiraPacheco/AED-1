#include <stdio.h>

int main() {
    int N, M;

    scanf("%d", &N);
    int fila[N];

    for (int i = 0; i < N; i++) {
        scanf("%d", &fila[i]);
    }

    scanf("%d", &M);
    int saiu[M];
    for (int i = 0; i < M; i++) {
        scanf("%d", &saiu[i]);
    }

    int flag[100001] = {0};
    for (int i = 0; i < M; i++) {
        flag[saiu[i]] = 1;
    }

    int primeiro = 1;
    for (int i = 0; i < N; i++) {
        if (!flag[fila[i]]) {
            if (!primeiro) {
                printf(" ");
            }
            printf("%d", fila[i]);
            primeiro = 0;
        }
    }
    printf("\n");

    return 0;
}

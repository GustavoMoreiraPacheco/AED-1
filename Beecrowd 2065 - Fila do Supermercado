#include <stdio.h>
#include <stdlib.h>

typedef struct {
    int tempo;
    int id;
} Funcionario;

typedef struct {
    Funcionario *dados;
    int tamanho;
} MinHeap;

MinHeap* criarMinHeap(int capacidade) {
    MinHeap *heap = (MinHeap*)malloc(sizeof(MinHeap));
    heap->dados = (Funcionario*)malloc(capacidade * sizeof(Funcionario));
    heap->tamanho = 0;
    return heap;
}

void trocar(Funcionario *a, Funcionario *b) {
    Funcionario temp = *a;
    *a = *b;
    *b = temp;
}

void minHeapify(MinHeap *heap, int indice) {
    int menor = indice;
    int esquerda = 2 * indice + 1;
    int direita = 2 * indice + 2;

    if (esquerda < heap->tamanho && (heap->dados[esquerda].tempo < heap->dados[menor].tempo || 
        (heap->dados[esquerda].tempo == heap->dados[menor].tempo && heap->dados[esquerda].id < heap->dados[menor].id))) {
        menor = esquerda;
    }

    if (direita < heap->tamanho && (heap->dados[direita].tempo < heap->dados[menor].tempo || 
        (heap->dados[direita].tempo == heap->dados[menor].tempo && heap->dados[direita].id < heap->dados[menor].id))) {
        menor = direita;
    }

    if (menor != indice) {
        trocar(&heap->dados[indice], &heap->dados[menor]);
        minHeapify(heap, menor);
    }
}

void inserirMinHeap(MinHeap *heap, Funcionario f) {
    heap->dados[heap->tamanho] = f;
    int i = heap->tamanho;
    heap->tamanho++;

    while (i != 0 && (heap->dados[(i - 1) / 2].tempo > heap->dados[i].tempo || 
        (heap->dados[(i - 1) / 2].tempo == heap->dados[i].tempo && heap->dados[(i - 1) / 2].id > heap->dados[i].id))) {
        trocar(&heap->dados[i], &heap->dados[(i - 1) / 2]);
        i = (i - 1) / 2;
    }
}

Funcionario extrairMin(MinHeap *heap) {
    Funcionario raiz = heap->dados[0];
    heap->dados[0] = heap->dados[heap->tamanho - 1];
    heap->tamanho--;
    minHeapify(heap, 0);
    return raiz;
}

int main() {
    int N, M;
    scanf("%d %d", &N, &M);

    int vi[N], cj[M];
    for (int i = 0; i < N; i++) {
        scanf("%d", &vi[i]);
    }
    for (int i = 0; i < M; i++) {
        scanf("%d", &cj[i]);
    }

    MinHeap *heap = criarMinHeap(N);

    for (int i = 0; i < N; i++) {
        Funcionario f = {0, i};
        inserirMinHeap(heap, f);
    }

    for (int i = 0; i < M; i++) {
        Funcionario f = extrairMin(heap);
        f.tempo += vi[f.id] * cj[i];
        inserirMinHeap(heap, f);
    }

    int tempo_total = 0;
    while (heap->tamanho > 0) {
        Funcionario f = extrairMin(heap);
        if (f.tempo > tempo_total) {
            tempo_total = f.tempo;
        }
    }

    printf("%d\n", tempo_total);

    free(heap->dados);
    free(heap);

    return 0;
}

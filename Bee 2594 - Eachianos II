#include <stdio.h>
#include <string.h>

#define MAX_TEXTO 128
#define MAX_PALAVRA 128
#define MAX_Q 100000

int main() {
    int q;
    scanf("%d", &q);

    for (int i = 0; i < q; i++) {
        char texto[MAX_TEXTO + 1];
        char palavra[MAX_PALAVRA + 1];

        scanf(" %[^\n]", texto);
        scanf("%s", palavra);

        int comprimento_palavra = strlen(palavra);
        int encontrado = 0;

        for (int j = 0; j <= strlen(texto) - comprimento_palavra; j++) {
            if (j == 0 || texto[j - 1] == ' ') {
                if (strncmp(&texto[j], palavra, comprimento_palavra) == 0 &&
                    (texto[j + comprimento_palavra] == ' ' || texto[j + comprimento_palavra] == '\0')) {
                    if (encontrado) {
                        printf(" ");
                    }
                    printf("%d", j);
                    encontrado = 1;
                }
            }
        }

        if (!encontrado) {
            printf("-1");
        }
        printf("\n");
    }

    return 0;
}

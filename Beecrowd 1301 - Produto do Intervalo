#include <stdio.h>
#include <stdlib.h>

#define MAX_N 100000

int arvore_segmento[4 * MAX_N];
int arr[MAX_N];
int n, k;

void construir_arvore(int node, int start, int end) {
    if (start == end) {
        arvore_segmento[node] = arr[start];
    } else {
        int mid = (start + end) / 2;
        construir_arvore(2 * node, start, mid);
        construir_arvore(2 * node + 1, mid + 1, end);
        arvore_segmento[node] = arvore_segmento[2 * node] * arvore_segmento[2 * node + 1];
    }
}

void atualizar_arvore(int node, int start, int end, int idx, int valor) {
    if (start == end) {
        arr[idx] = valor;
        arvore_segmento[node] = valor;
    } else {
        int mid = (start + end) / 2;
        if (start <= idx && idx <= mid) {
            atualizar_arvore(2 * node, start, mid, idx, valor);
        } else {
            atualizar_arvore(2 * node + 1, mid + 1, end, idx, valor);
        }
        arvore_segmento[node] = arvore_segmento[2 * node] * arvore_segmento[2 * node + 1];
    }
}

int consultar_arvore(int node, int start, int end, int l, int r) {
    if (r < start || end < l) {
        return 1;
    }
    if (l <= start && end <= r) {
        return arvore_segmento[node];
    }
    int mid = (start + end) / 2;
    int p1 = consultar_arvore(2 * node, start, mid, l, r);
    int p2 = consultar_arvore(2 * node + 1, mid + 1, end, l, r);
    return p1 * p2;
}

int main() {
    while (scanf("%d %d", &n, &k) != EOF) {
        for (int i = 0; i < n; i++) {
            scanf("%d", &arr[i]);
            if (arr[i] > 0) arr[i] = 1;
            else if (arr[i] < 0) arr[i] = -1;
        }

        construir_arvore(1, 0, n - 1);

        for (int i = 0; i < k; i++) {
            char comando;
            int x, y;
            scanf(" %c %d %d", &comando, &x, &y);

            if (comando == 'C') {
                if (y > 0) y = 1;
                else if (y < 0) y = -1;
                atualizar_arvore(1, 0, n - 1, x - 1, y);
            } else if (comando == 'P') {
                int resultado = consultar_arvore(1, 0, n - 1, x - 1, y - 1);
                if (resultado > 0) printf("+");
                else if (resultado < 0) printf("-");
                else printf("0");
            }
        }
        printf("\n");
    }

    return 0;
}

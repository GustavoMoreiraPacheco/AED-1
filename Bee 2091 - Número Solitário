#include <stdio.h>

int main() {
    int N;
    
    while (scanf("%d", &N) && N != 0) {
        long long numero;
        long long resultado = 0;

        for (int i = 0; i < N; i++) {
            scanf("%lld", &numero);
            resultado ^= numero;
        }

        printf("%lld\n", resultado);
    }

    return 0;
}
